ır.**\n"]},{"cell_type":"code","execution_count":67,"id":"6c8ece22","metadata":{"execution":{"iopub.execute_input":"2026-11-18T11:18:35.576102Z","iopub.status.busy":"2026-11-18T11:18:35.57473Z","iopub.status.idle":"2026-11-18T11:18:35.580294Z","shell.execute_reply":"2026-11-18T11:18:35.5791Z"},"papermill":{"duration":0.022785,"end_time":"2026-11-18T11:18:35.582845+00:00","exception":false,"start_time":"2026-11-18T11:18:35.56006+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# LASSO CROSS VALIDATION\n"]},{"cell_type":"code","execution_count":68,"id":"f2689c00","metadata":{"execution":{"iopub.execute_input":"2026-11-18T11:18:35.615207Z","iopub.status.busy":"2026-11-18T11:18:35.614793Z","iopub.status.idle":"2026-11-18T11:18:35.620382Z","shell.execute_reply":"2026-11-18T11:18:35.61909Z"},"papermill":{"duration":0.025662,"end_time":"2026-11-18T11:18:35.622682+00:00","exception":false,"start_time":"2026-11-18T11:18:35.59702+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from sklearn.linear_model import LassoCV\n"]},{"cell_type":"code","execution_count":69,"id":"4a1b6091","metadata":{"execution":{"iopub.execute_input":"2026-11-18T11:18:35.661531Z","iopub.status.busy":"2026-11-18T11:18:35.661104Z","iopub.status.idle":"2026-11-18T11:18:35.899512Z","shell.execute_reply":"2026-11-18T11:18:35.898465Z"},"papermill":{"duration":0.263529,"end_time":"2026-11-18T11:18:35.90187+00:00","exception":false,"start_time":"2026-11-18T11:18:35.638341+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Mean Absolute error :  0.7222308156305418\n","Mean Squared Error :  0.8972011670293636\n","R2 Score :  0.9834904632842026\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 640x480 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["lassocv = LassoCV(cv=5)\n","lassocv.fit(X_train_scaled, y_train)\n","y_pred = lassocv.predict(X_test_scaled)\n","mae = mean_absolute_error(y_test, y_pred)\n